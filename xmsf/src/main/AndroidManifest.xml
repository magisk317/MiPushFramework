<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <permission
            android:name="com.xiaomi.xmsf.permission.MIPUSH_RECEIVE"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.NOTIFICATION_ACTIVE"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.LOG_PROVIDER"
            android:protectionLevel="signature" />
    <permission
            android:name="com.xiaomi.xmsf.permission.USE_XMSF_UPLOAD"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.USE_XMSF_TRAFFIC"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.READ_XMSF_LOG"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.CHANNEL"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.push.permission.PUSH_SUPPORT"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.UPDATE_KA_CONFIG"
            android:protectionLevel="signatureOrSystem" />
    <permission
            android:name="com.xiaomi.xmsf.permission.READ_KEEPALIVE_PREFS"
            android:protectionLevel="signature" />
    <permission
            android:name="com.xiaomi.xmsf.permission.READ_ISLAND_PREFS"
            android:protectionLevel="signature" />
    <permission
            android:name="com.xiaomi.xmsf.permission.BIND_MANAGER_RUNTIME"
            android:protectionLevel="signature" />
    <!-- Stock XMSF 7.4.67-C declares this permission for the USE_INTELLIGENT_HB broadcast so only
         system/signature callers can request a short heartbeat keep window. XMPushService registers
         its receiver with this permission, so the package must both declare and use it. -->
    <permission
            android:name="com.xiaomi.xmsf.permission.INTELLIGENT_HB"
            android:protectionLevel="signatureOrSystem" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.xiaomi.xmsf.permission.MIPUSH_RECEIVE" />
    <uses-permission android:name="com.xiaomi.xmsf.permission.NOTIFICATION_ACTIVE" />
    <uses-permission android:name="com.xiaomi.xmsf.permission.USE_XMSF_UPLOAD" />
    <uses-permission android:name="com.xiaomi.xmsf.permission.READ_ISLAND_PREFS" />
    <uses-permission android:name="com.xiaomi.xmsf.permission.INTELLIGENT_HB" />
    <uses-permission android:name="com.xiaomi.permission.SEND_PUSH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
            android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"
            tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="UseExactAlarm" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission
            android:name="android.permission.UPDATE_APP_OPS_STATS"
            tools:ignore="ProtectedPermissions" />

    <!-- Stock XMSF 7.4.67-C requests this signature permission for ProcessMonitor. The observer
         adapter falls back to 60-second polling when the installed package is not granted it. -->
    <uses-permission
            android:name="android.permission.SET_ACTIVITY_WATCHER"
            tools:ignore="ProtectedPermissions" />

    <uses-permission
            android:name="android.permission.QUERY_ALL_PACKAGES"
            tools:ignore="QueryAllPackagesPermission" />

    <uses-permission
            android:name="android.permission.PACKAGE_USAGE_STATS"
            tools:ignore="ProtectedPermissions" />

    <application
            android:name="io.github.magisk317.mipush.app.MiPushFrameworkApp"
            android:allowBackup="false"
            android:icon="@mipmap/ic_app"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/AppTheme"
            android:resizeableActivity="true"
            android:networkSecurityConfig="@xml/network_security_config"
            tools:ignore="GoogleAppIndexingWarning"
            android:forceQueryable="true">
        <meta-data
                android:name="pushSupportFlag"
                android:value="4" />
        <meta-data
                android:name="support_ka"
                android:value="true" />
        <meta-data
                android:name="com.xiaomi.xms.support_kit"
                android:value="true" />

        <service
                android:name="io.github.magisk317.mipush.service.KeepAliveAccessibilityService"
                android:exported="false"
                android:label="@string/pref_keepalive_dedicated_service_title"
                android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                    android:name="android.accessibilityservice"
                    android:resource="@xml/keepalive_accessibility_service" />
        </service>


        <activity
                android:name=".ShareLogActivity"
                android:exported="false" />
        <activity
                android:name=".RemoveDozeActivity"
                android:exported="false" />

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="com.xiaomi.xmsf.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/filepaths" />
        </provider>
        <provider
                android:name="androidx.startup.InitializationProvider"
                android:authorities="${applicationId}.androidx-startup"
                android:exported="false"
                tools:node="merge">
            <meta-data
                    android:name="com.xiaomi.xmsf.startup.LogInitializer"
                    android:value="androidx.startup" />
        </provider>
        <provider
                android:name="com.xiaomi.xmsf.utils.ModuleLogProvider"
                android:authorities="com.xiaomi.xmsf.module.log"
                android:exported="true"
                tools:ignore="ExportedContentProvider"
                android:grantUriPermissions="false" />
        <provider
                android:name="com.xiaomi.push.providers.TrafficProvider"
                android:authorities="com.xiaomi.push.providers.TrafficProvider"
                android:permission="com.xiaomi.xmsf.permission.USE_XMSF_TRAFFIC"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.xmsf.provider.MiCloudSettingsProvider"
                android:authorities="com.xiaomi.xmsf.provider.MiCloudSettingsProvider"
                android:writePermission="com.xiaomi.permission.CLOUD_MANAGER"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.xmsf.provider.KeepAlivePreferenceProvider"
                android:authorities="com.xiaomi.xmsf.keepalive.prefs"
                android:readPermission="com.xiaomi.xmsf.permission.READ_KEEPALIVE_PREFS"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.xmsf.provider.IslandPreferenceProvider"
                android:authorities="com.xiaomi.xmsf.island.prefs"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.xmsf.pushcontrol.PushControlProvider"
                android:authorities="com.xiaomi.xmsf.pushcontrol.PushControlProvider"
                tools:ignore="ExportedContentProvider"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.xmsf.provider.ChannelProvider"
                android:authorities="com.xiaomi.xmsf.provider.CHANNEL"
                android:permission="com.xiaomi.xmsf.permission.CHANNEL"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.push.provider.PushSupportProvider"
                android:authorities="com.xiaomi.push.provider.PUSH_SUPPORT"
                android:permission="com.xiaomi.push.permission.PUSH_SUPPORT"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.push.provider.PushCommonProvider"
                android:authorities="com.xiaomi.push.provider.PUSH_COMMON"
                tools:ignore="ExportedContentProvider"
                android:exported="true" />
        <provider
                android:name="com.xiaomi.xmsf.provider.PushProfileIdProvider"
                android:authorities="com.xiaomi.push.provider.profile"
                tools:ignore="ExportedContentProvider"
                android:exported="true" />

        <receiver
                android:name="io.github.magisk317.mipush.receiver.BootReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="io.github.magisk317.mipush.receiver.NetworkStatusReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="com.xiaomi.push.service.receivers.PingReceiver"
                android:exported="false">
            <intent-filter>
                <action android:name="com.xiaomi.push.PING_TIMER" />
            </intent-filter>
        </receiver>
        <receiver
                android:name="io.github.magisk317.mipush.notification.FocusInteractionReceiver"
                android:exported="true"
                android:permission="com.android.systemui.permission.NOTIFICATION">
            <intent-filter>
                <action android:name="com.android.systemui.action.NOTIFICATION_INTERACTION_EVENT" />
            </intent-filter>
        </receiver>

        <!-- Stock XMSF 7.4.67-C registers PkgActionsReceiver for package add/remove/data-clear
             events. MiPushFramework keeps add/remove for its existing XSpace and uninstall paths
             and adds data-clear for registration cleanup. PACKAGE_CHANGED, PACKAGE_REPLACED, and
             PACKAGE_RESTARTED only refresh stock OnePush/extension state, which is not restored. -->
        <receiver
                android:name="io.github.magisk317.mipush.receiver.PkgUninstallReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_DATA_CLEARED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="com.xiaomi.xmsf.push.service.receivers.MiuiPushMessageReceiver"
                android:exported="false">
            <intent-filter>
                <action android:name="com.xiaomi.mipush.RECEIVE_MESSAGE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.xiaomi.mipush.ERROR" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="com.xiaomi.xmsf.push.service.receivers.AccountChangedReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.LOGIN_ACCOUNTS_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="com.xiaomi.xmsf.push.service.receivers.NotificationEventReceiver"
                android:exported="true"
                android:permission="com.xiaomi.xmsf.permission.NOTIFICATION_ACTIVE">
            <intent-filter>
                <action android:name="com.xiaomi.xmsf.push.NOTIFICATION_ACTIVE" />
            </intent-filter>
        </receiver>
        <receiver
                android:name="com.xiaomi.xmsf.push.service.receivers.XMSFUploadReceiver"
                android:exported="true"
                android:permission="com.xiaomi.xmsf.permission.USE_XMSF_UPLOAD">
            <intent-filter>
                <action android:name="com.xiaomi.xmsf.push.XMSF_UPLOAD_ACTIVE" />
            </intent-filter>
        </receiver>
        <receiver
                android:name="com.xiaomi.xmsf.pushprocess.PushInnerReceiver"
                android:exported="false">
            <intent-filter>
                <action android:name="com.xiaomi.xmsf.inner.PUSH_MESSAGE" />
            </intent-filter>
        </receiver>
        <receiver
                android:name="com.xiaomi.push.service.SelfUpdateReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="com.xiaomi.push.revival.NotificationsRevivalForSelfUpdated"
                android:exported="false" />
        <!--
          Stock XMSF 7.4.67-C exports HttpService without a bind permission. The older project
          added a signature permission that rejected ordinary stock clients. The implementation
          remains telemetry-safe: it returns only local canned MiStat responses and never uploads.
        -->
        <service
                android:name=".push.service.HttpService"
                android:exported="true" />
        <!--
          Stock XMSF 7.4.67-C exports StatService while returning null from onBind. The older
          project made it internal; exporting the inert service restores discovery without
          accepting, persisting, or forwarding telemetry.
        -->
        <service
                android:name="com.xiaomi.xmsf.push.service.StatService"
                android:exported="true" />
        <service
                android:name="com.xiaomi.xmsf.push.service.notificationcollection.NotificationListener"
                android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
                android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
                android:name="com.xiaomi.xmsf.services.MainProcBridgeService"
                android:enabled="true"
                android:exported="false" />
        <service
                android:name="io.github.magisk317.mipush.manager.runtime.ManagerRuntimeService"
                android:exported="true"
                android:permission="com.xiaomi.xmsf.permission.BIND_MANAGER_RUNTIME">
            <intent-filter>
                <action android:name="io.github.magisk317.mipush.action.BIND_MANAGER_RUNTIME" />
            </intent-filter>
        </service>
        <!--
          Stock XMSF 7.4.67-C exports ServiceBoxService, but its confirmed caller (dc.e) is in the
          XMSF package and binds explicitly across processes. Keep the project service internal:
          its Binder refreshes online-config/keepalive state, so external exposure adds a denial
          surface without a known compatibility consumer.
        -->
        <service
                android:name="com.xiaomi.xmsf.services.ServiceBoxService"
                android:exported="false"
                android:process=":services" />
        <service
                android:name="com.xiaomi.xmsf.services.keepalive.strategy.KeepAliveConfigService"
                android:permission="com.xiaomi.xmsf.permission.UPDATE_KA_CONFIG"
                android:exported="true"
                android:process=":services">
            <intent-filter>
                <action android:name="com.xiaomi.xmsf.service.UPDATE_KA_CONFIG" />
            </intent-filter>
        </service>
        <service
                android:name="com.xiaomi.xmsf.sync.BindMiCloudPushService"
                android:permission="com.xiaomi.permission.CLOUD_MANAGER"
                android:enabled="true"
                android:exported="true">
            <intent-filter>
                <action android:name="com.xiaomi.xmsf.sync.BIND_PUSH_SERVICE" />
            </intent-filter>
        </service>

        <service
                android:name=".push.service.XMPushService"
                android:foregroundServiceType="remoteMessaging"
                tools:ignore="ExportedService"
                android:exported="true" />
        <service
                android:name="com.xiaomi.push.service.XMPushService"
                android:foregroundServiceType="remoteMessaging"
                tools:ignore="ExportedService"
                android:exported="true" />
        <service
                android:name="com.xiaomi.push.service.XMPushServiceCore"
                android:foregroundServiceType="remoteMessaging"
                android:exported="false" />


        <!--app -->

        <service
                android:name="com.xiaomi.mipush.sdk.PushMessageHandler"
                android:permission="com.xiaomi.xmsf.permission.MIPUSH_RECEIVE"
                android:enabled="true"
                tools:ignore="ExportedService"
                android:exported="true" />
        <service
                android:name="com.xiaomi.mipush.sdk.MessageHandleService"
                android:exported="false" />
        <service
                android:name="com.xiaomi.push.service.XMJobService"
                android:enabled="true"
                android:exported="false"
                android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          Stock XMSF 7.4.67-C exports MiuiPushActivateService, whose onHandleIntent is empty. The
          older project kept it internal while separately invoking a non-stock package scan.
          Export the inert compatibility service after removing that scan and its target launches.
        -->
        <service
                android:name=".push.service.MiuiPushActivateService"
                android:exported="true" />

        <service
                android:name="com.xiaomi.push.sdk.MyPushMessageHandler"
                android:exported="false" />

        <!-- Push API -->

    </application>


</manifest>
