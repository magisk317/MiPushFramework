<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for MiPushFramework.

    Cleartext (HTTP) traffic is required by the legacy Xiaomi push protocol stack
    (XMPP connection, channel negotiation, and telemetry endpoints) which uses
    non-TLS connections to Xiaomi infrastructure hosts.

    This config restricts cleartext to known Xiaomi push domains instead of the
    blanket android:usesCleartextTraffic="true" manifest flag.
-->
<network-security-config>
    <!-- Default: require HTTPS for all traffic -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Allow cleartext only for Xiaomi push infrastructure domains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">qlogo.cn</domain>
        <domain includeSubdomains="true">xiaomi.com</domain>
        <domain includeSubdomains="true">mi.com</domain>
        <domain includeSubdomains="true">miui.com</domain>
        <domain includeSubdomains="true">xmpush.xiaomi.com</domain>
        <!-- localhost for local debug/testing -->
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
