{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "forkProcessing": "enabled",
    "pruneStaleBranches": true,
    "pruneBranchAfterAutomerge": true,
    "baseBranchPatterns": [
        "dev"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "other non-major dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "all-minor-patch",
            "commitMessageExtra": "",
            "matchPackageNames": [
                "!/^androidx\\./",
                "!/^org\\.jetbrains\\.kotlin/",
                "!/^io\\.insert-koin\\./",
                "!/^org\\.junit\\./",
                "!/^dev\\.chrisbanes\\.haze/"
            ]
        },
        {
            "matchManagers": [
                "gradle",
                "maven"
            ],
            "addLabels": [
                "dependencies",
                "java"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "dependencies",
                "github_actions"
            ]
        },
        {
            "matchPackageNames": [
                "int:versionCode",
                "int:pushVersionCode",
                "int:MODULE_VERSION",
                "int:VERSION_CODE",
                "int:PUSH_VERSION_CODE",
                "int:RUNTIME_API_VERSION"
            ],
            "enabled": false
        }
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security"]
    }
}
