<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name="io.github.magisk317.mipush.app.App"
        android:allowBackup="true"
        android:description="@string/xposedDescription"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher_xmsf"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="tiramisu">

        
        <activity
            android:name="io.github.magisk317.mipush.app.ManagerLauncherActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_xmsf"
            android:noHistory="true"
            android:theme="@style/AppTheme">
            <!-- No LAUNCHER filter: desktop icons are activity-aliases so icon can be switched. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="io.github.magisk317.mipush.app.ManagerLauncherActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_xmsf"
            android:label="@string/app_name"
            android:targetActivity="io.github.magisk317.mipush.app.ManagerLauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <activity
            android:name="io.github.magisk317.mipush.feature.wizard.WelcomeActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="io.github.magisk317.mipush.feature.wizard.RequestPermissionPage"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="io.github.magisk317.mipush.feature.main.MainActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="io.github.magisk317.mipush.feature.main.ApplicationInfoPage"
            android:configChanges="screenLayout|screenSize|orientation"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="io.github.magisk317.mipush.feature.main.subpage.ConnectionStatusPage"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="io.github.magisk317.mipush.feature.main.ZygiskConfigPage"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="io.github.magisk317.mipush.feature.main.RecentEventListPage"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <service
            android:name="io.github.magisk317.mipush.app.RuntimeLogExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <receiver
            android:name="io.github.magisk317.mipush.app.widget.ConnectionStatusWidgetProvider"
            android:exported="true"
            android:label="@string/widget_connection_status_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mipush_widget_connection_status" />
        </receiver>

        <provider
            android:name="io.github.magisk317.mipush.app.EventListCacheProvider"
            android:authorities="io.github.magisk317.mipush.event-cache"
            android:exported="true"
            android:permission="com.xiaomi.xmsf.permission.BIND_MANAGER_RUNTIME" />

        <receiver
            android:name="io.github.magisk317.mipush.app.widget.RecentEventsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_recent_events_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mipush_widget_recent_events" />
        </receiver>
    </application>
</manifest>
