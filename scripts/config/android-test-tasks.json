{
  "full_tasks": [
    "android-pure-modules"
  ],
  "full_paths": [
    "build.gradle*",
    "settings.gradle*",
    "gradle.properties",
    "gradle/*",
    "build-logic/*",
    ".gitmodules",
    "scripts/*",
    ".magisk-ci-toolkit/*"
  ],
  "ignore_paths": [
    "impact",
    "log/*",
    "art/*",
    "fastlane/*",
    ".gitlab-ci.yml",
    ".github/workflows/*",
    "docs/*",
    "README*",
    "LICENSE*",
    "CHANGELOG*",
    ".github/*",
    ".gitlab/*",
    "config/*"
  ],
  "unknown": "full",
  "rules": [
    {
      "paths": [
        "xmsf/src/*",
        "xmsf/build.gradle.kts",
        "xmsf/proguard-rules.pro"
      ],
      "tasks": [
        "xmsf-compile"
      ]
    },
    {
      "paths": [
        "mipush/*"
      ],
      "tasks": [
        "mipush-compile"
      ]
    },
    {
      "paths": [
        "common/*",
        "core/*",
        "xmsf/*",
        "xposed/*",
        "manager/*",
        "settings/*",
        "configuration/*",
        "vendor/*",
        "pinned/*",
        "magisk-ui-kit/*",
        "magisk-xposed-kit/*"
      ],
      "tasks": [
        "android-pure-modules"
      ]
    }
  ]
}
